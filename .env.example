# Agentic AI - Environment Configuration
# Copy this file to .env and fill in your values

# ============================================================
# ENVIRONMENT
# ============================================================
ENVIRONMENT=development  # development, staging, production

# ============================================================
# LLM PROVIDER SETTINGS (at least one required)
# ============================================================
DEFAULT_LLM_PROVIDER=openai  # openai, anthropic, azure_openai
DEFAULT_MODEL=gpt-4o
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=4096

# OpenAI
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Azure OpenAI
AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/

# ============================================================
# DATABASE SETTINGS
# ============================================================
# PostgreSQL (for HITL v2 checkpoints)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agentic_ai

# Redis (for short-term memory, rate limiting, HITL)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=  # optional

# ============================================================
# VECTOR DATABASE
# ============================================================
VECTOR_DB_PROVIDER=chroma  # chroma, pinecone, faiss
CHROMA_HOST=localhost
CHROMA_PORT=8000

# Pinecone (if using)
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=your-pinecone-environment

# ============================================================
# API SETTINGS
# ============================================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_KEY_HEADER=X-API-Key

# JWT Authentication
JWT_SECRET_KEY=change-me-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# ============================================================
# RATE LIMITING
# ============================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# ============================================================
# HITL (HUMAN-IN-THE-LOOP)
# ============================================================
HITL_ENABLED=true
HITL_TIMEOUT_SECONDS=3600
HITL_NOTIFICATION_EMAIL=your-email@example.com
HITL_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
HITL_WEBHOOK_SECRET=change-me-in-production

# ============================================================
# OBSERVABILITY
# ============================================================
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json  # json, text
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=agentic-ai-starter
CLOUDWATCH_ENABLED=false

# ============================================================
# SECURITY
# ============================================================
ENABLE_CORS=true
CORS_ORIGINS=["http://localhost:3000", "http://localhost:3001"]
PII_DETECTION_ENABLED=true
INPUT_SANITIZATION_ENABLED=true

# ============================================================
# FEATURE FLAGS
# ============================================================
ENABLE_PARALLEL_EXECUTION=true
ENABLE_REFLECTION_LOOPS=true
ENABLE_TOOL_CACHING=true

# ============================================================
# AWS (for CloudWatch, Secrets Manager, etc.)
# ============================================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
DYNAMODB_TABLE_NAME=agent-state
S3_BUCKET_NAME=agent-artifacts

# ============================================================
# NSJAIL (for code execution sandbox)
# ============================================================
NSJAIL_PATH=nsjail  # Path to nsjail binary, or set USE_NSJAIL=false to disable

# ============================================================
# DEVELOPMENT OVERRIDES
# ============================================================
# In development mode, these are more permissive
# Set ENVIRONMENT=production to enforce strict settings